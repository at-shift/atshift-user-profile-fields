#: includes/class-atshift-upf-admin.php:195
#, php-format
msgid ""
"On the Add New User screen, %1$s are unavailable, so only %2$s are shown."
msgstr ""
"Nella schermata Aggiungi nuovo utente, %1$s non sono disponibili, quindi "
"vengono mostrati solo %2$s."

#: includes/class-atshift-upf-admin.php:196
#, php-format
msgid ""
"When editing an existing user, %1$s are unavailable, so only %2$s are shown."
msgstr ""
"Quando modifichi un utente esistente, %1$s non sono disponibili, quindi "
"vengono mostrati solo %2$s."

#: includes/class-atshift-upf-admin.php:197
msgid ""
"This Conditional Group is not shown on the Add New User screen because none "
"of its conditions contain fields available there."
msgstr ""
"Questo Gruppo condizionale non viene mostrato nella schermata Aggiungi nuovo "
"utente perché nessuna delle sue condizioni contiene campi disponibili lì."

#: includes/class-atshift-upf-admin.php:198
msgid ""
"This Conditional Group is not shown when editing an existing user because "
"none of its conditions contain fields available there."
msgstr ""
"Questo Gruppo condizionale non viene mostrato durante la modifica di un "
"utente esistente perché nessuna delle sue condizioni contiene campi "
"disponibili lì."

#: includes/class-atshift-upf-admin.php:199
#, php-format
msgid ""
"On the Add New User screen, edit-only fields in this Accordion are omitted: "
"%s."
msgstr ""
"Nella schermata Aggiungi nuovo utente, i campi solo per la modifica in "
"questa Fisarmonica vengono omessi: %s."

#: includes/class-atshift-upf-admin.php:200
#, php-format
msgid ""
"When editing an existing user, registration-only fields in this Accordion "
"are omitted: %s."
msgstr ""
"Quando modifichi un utente esistente, i campi solo per la registrazione in "
"questa Fisarmonica vengono omessi: %s."

#: includes/class-atshift-upf-admin.php:201
msgid ""
"This Accordion is not shown on the Add New User screen because it contains "
"no fields available there."
msgstr ""
"Questa Fisarmonica non viene mostrata nella schermata Aggiungi nuovo utente "
"perché non contiene campi disponibili lì."

#: includes/class-atshift-upf-admin.php:202
msgid ""
"This Accordion is not shown when editing an existing user because it "
"contains no fields available there."
msgstr ""
"Questa Fisarmonica non viene mostrata durante la modifica di un utente "
"esistente perché non contiene campi disponibili lì."

#: includes/class-atshift-upf-admin.php:224
msgid ""
"Emergency safe mode is active. WordPress native profile fields are being "
"used and this plugin is not changing profile screens."
msgstr ""
"La modalità provvisoria di emergenza è attiva. Vengono usati i campi profilo "
"nativi di WordPress e questo plugin non modifica le schermate del profilo."

